# LookFit Environment Variables (Template)
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.

# Supabase Public Configuration (accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Service Role Key (SERVER ONLY - never leak to client bundle)
# Optional in MVP; standard user flows operate under user-scoped JWT sessions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
